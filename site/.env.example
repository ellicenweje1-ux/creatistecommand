# Where The Creatiste Command API lives (no trailing slash). Enquiries post here.
VITE_API_BASE=https://creatistecommand.onrender.com
# Your personal enquiry token from Command → Settings → App & integrations → Public enquiry link
# (the last part of that link). Leave blank and the form falls back to email.
VITE_ENQUIRY_TOKEN=
# "hash" for static hosts with no SPA fallback (the artifact preview); leave unset on Cloudflare Pages.
VITE_ROUTER=
